{
  "info": {
    "name": "Star Wars Films API",
    "description": "Film management API built with NestJS.\n\nEverything is pre-filled — open any request and press Send, in any order. When `accessToken` is empty a collection-level script logs in as the regular user first, and if that account does not exist yet it creates it through `POST /auth/register`, the same endpoint any client would use.\n\nThe administrator is the one account that cannot come from the API: registration hardcodes the USER role so nobody can self-promote. Run `pnpm db:seed` once to create it.\n\n| Role | Email | Password | Created by |\n| --- | --- | --- | --- |\n| ADMIN | admin@starwars.test | Password123! | `pnpm db:seed` |\n| USER | user@starwars.test | Password123! | the collection, via `/auth/register` |\n\nPoint `baseUrl` somewhere else and the whole collection follows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Makes every protected request runnable on its own: logs in as the",
          "// regular user, and on a fresh database creates that account first",
          "// through the public registration endpoint. Only fires when there is",
          "// no token yet — clear `accessToken` to force it to run again.",
          "if (pm.collectionVariables.get('accessToken')) {",
          "  return;",
          "}",
          "",
          "const baseUrl = pm.collectionVariables.get('baseUrl');",
          "const email = pm.collectionVariables.get('userEmail');",
          "const password = pm.collectionVariables.get('userPassword');",
          "const name = pm.collectionVariables.get('userName');",
          "",
          "const post = (path, body) => ({",
          "  url: `${baseUrl}${path}`,",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify(body) },",
          "});",
          "",
          "const store = (response) =>",
          "  pm.collectionVariables.set('accessToken', response.json().accessToken);",
          "",
          "pm.sendRequest(post('/auth/login', { email, password }), (loginError, loginResponse) => {",
          "  if (!loginError && loginResponse.code === 200) {",
          "    store(loginResponse);",
          "    return;",
          "  }",
          "",
          "  pm.sendRequest(",
          "    post('/auth/register', { email, name, password }),",
          "    (registerError, registerResponse) => {",
          "      if (registerError || registerResponse.code !== 201) {",
          "        console.warn('Could not obtain a token. Is the API running on ' + baseUrl + '?');",
          "        return;",
          "      }",
          "",
          "      store(registerResponse);",
          "    },",
          "  );",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "user@starwars.test",
      "type": "string"
    },
    {
      "key": "userName",
      "value": "Luke Skywalker",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@starwars.test",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "newUserEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Runs a real query against the database, so a 200 here means the whole chain (Nest, Prisma, Postgres) is up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('service is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('database is reachable', () => pm.expect(body.database).to.eql('up'));",
                  "pm.test('uptime is a number', () => pm.expect(body.uptime).to.be.a('number'));",
                  "pm.test('timestamp is a valid date', () => pm.expect(Date.parse(body.timestamp)).to.not.be.NaN);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route returns 404",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["does-not-exist"]
            },
            "description": "Baseline for the error shape. Every error the API returns should look like this one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 404', () => pm.response.to.have.status(404));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('error payload has the standard shape', () => {",
                  "  pm.expect(body).to.have.property('statusCode', 404);",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as the regular user and stores the token in `accessToken`, which every protected request inherits. The account is created by the collection through `/auth/register` the first time it is needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a bearer token', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "pm.test('is a regular USER account', () => pm.expect(body.user.role).to.eql('USER'));",
                  "",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as administrator",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Swaps `accessToken` for an administrator token. Send this before the admin-only endpoints, and `Login` again to go back to a regular user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('is the seeded ADMIN account', () => pm.expect(body.user.role).to.eql('ADMIN'));",
                  "",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the profile behind the current token. Resolved against the database on every call, so a token whose user was deleted stops working immediately."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a profile', () => {",
                  "  pm.expect(body.email).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.role).to.be.oneOf(['ADMIN', 'USER']);",
                  "});",
                  "",
                  "pm.test('never leaks the password', () => pm.expect(pm.response.text()).to.not.include('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me without a token returns 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"name\": \"Wedge Antilles\",\n  \"password\": \"the-force-is-strong\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates an account. The email is generated fresh on every send, so this request always succeeds and never collides with a previous run. New accounts always get the USER role."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newUserEmail', `wedge-${Date.now()}@rebellion.org`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a bearer token', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "pm.test('new accounts get the USER role', () => pm.expect(body.user.role).to.eql('USER'));",
                  "pm.test('never leaks the password', () => pm.expect(pm.response.text()).to.not.include('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with a duplicate email returns 409",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"name\": \"Luke Skywalker\",\n  \"password\": \"the-force-is-strong\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Re-registers the regular user, which the collection guarantees exists, so this request is standalone and repeatable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with an invalid payload returns 400",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"name\": \"L\",\n  \"password\": \"short\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Every field is wrong on purpose: the response should list all three problems at once, not just the first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));",
                  "",
                  "const message = JSON.stringify(pm.response.json().message);",
                  "",
                  "pm.test('reports every invalid field at once', () => {",
                  "  pm.expect(message).to.include('email');",
                  "  pm.expect(message).to.include('name');",
                  "  pm.expect(message).to.include('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register cannot grant the ADMIN role",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sneaky@empire.gov\",\n  \"name\": \"Sheev Palpatine\",\n  \"password\": \"unlimited-power\",\n  \"role\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Tries to self-promote by smuggling a `role` field into the payload. The validation pipe strips unknown properties and rejects the request, so no account is created at all."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));",
                  "",
                  "pm.test('rejects the unknown property explicitly', () => {",
                  "  pm.expect(JSON.stringify(pm.response.json().message)).to.include('role');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password returns 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"definitely-not-it\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 401', () => pm.response.to.have.status(401));",
                  "",
                  "pm.test('does not reveal whether the account exists', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Invalid email or password.');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
