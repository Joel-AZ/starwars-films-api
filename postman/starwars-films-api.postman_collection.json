    },
    {
      "key": "filmId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Runs a real query against the database, so a 200 here means the whole chain (Nest, Prisma, Postgres) is up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('service is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('database is reachable', () => pm.expect(body.database).to.eql('up'));",
                  "pm.test('uptime is a number', () => pm.expect(body.uptime).to.be.a('number'));",
                  "pm.test('timestamp is a valid date', () => pm.expect(Date.parse(body.timestamp)).to.not.be.NaN);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route returns 404",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["does-not-exist"]
            },
            "description": "Baseline for the error shape. Every error the API returns should look like this one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 404', () => pm.response.to.have.status(404));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('error payload has the standard shape', () => {",
                  "  pm.expect(body).to.have.property('statusCode', 404);",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as the regular user and stores the token in `accessToken`, which every protected request inherits. The account is created by the collection through `/auth/register` the first time it is needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a bearer token', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "pm.test('is a regular USER account', () => pm.expect(body.user.role).to.eql('USER'));",
                  "",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as administrator",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Stores an administrator token in `adminToken`, which the admin-only requests use. Kept apart from `accessToken` so both roles are available at the same time and nothing has to be re-logged in between requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('is the seeded ADMIN account', () => pm.expect(body.user.role).to.eql('ADMIN'));",
                  "",
                  "pm.collectionVariables.set('adminToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the profile behind the current token. Resolved against the database on every call, so a token whose user was deleted stops working immediately."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a profile', () => {",
                  "  pm.expect(body.email).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.role).to.be.oneOf(['ADMIN', 'USER']);",
                  "});",
                  "",
                  "pm.test('never leaks the password', () => pm.expect(pm.response.text()).to.not.include('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me without a token returns 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"name\": \"Wedge Antilles\",\n  \"password\": \"the-force-is-strong\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates an account. The email is generated fresh on every send, so this request always succeeds and never collides with a previous run. New accounts always get the USER role."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newUserEmail', `wedge-${Date.now()}@rebellion.org`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a bearer token', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "pm.test('new accounts get the USER role', () => pm.expect(body.user.role).to.eql('USER'));",
                  "pm.test('never leaks the password', () => pm.expect(pm.response.text()).to.not.include('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with a duplicate email returns 409",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"name\": \"Luke Skywalker\",\n  \"password\": \"the-force-is-strong\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Re-registers the regular user, which the collection guarantees exists, so this request is standalone and repeatable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with an invalid payload returns 400",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"name\": \"L\",\n  \"password\": \"short\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Every field is wrong on purpose: the response should list all three problems at once, not just the first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));",
                  "",
                  "const message = JSON.stringify(pm.response.json().message);",
                  "",
                  "pm.test('reports every invalid field at once', () => {",
                  "  pm.expect(message).to.include('email');",
                  "  pm.expect(message).to.include('name');",
                  "  pm.expect(message).to.include('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register cannot grant the ADMIN role",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sneaky@empire.gov\",\n  \"name\": \"Sheev Palpatine\",\n  \"password\": \"unlimited-power\",\n  \"role\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Tries to self-promote by smuggling a `role` field into the payload. The validation pipe strips unknown properties and rejects the request, so no account is created at all."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));",
                  "",
                  "pm.test('rejects the unknown property explicitly', () => {",
                  "  pm.expect(JSON.stringify(pm.response.json().message)).to.include('role');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password returns 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"definitely-not-it\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 401', () => pm.response.to.have.status(401));",
                  "",
                  "pm.test('does not reveal whether the account exists', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Invalid email or password.');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Films",
      "description": "Runs top to bottom: creates a film as administrator, reads it as a regular user, updates it, deletes it and confirms it is gone — so the folder leaves the database exactly as it found it.",
      "item": [
        {
          "name": "List films",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/films?page=1&limit=10&sortBy=episodeId&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["films"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "episodeId" },
                { "key": "sortOrder", "value": "asc" }
              ]
            },
            "description": "The only film endpoint the brief leaves unrestricted, so it takes no token. Paginated, searchable by title or director, sortable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200 without a token', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a page and its metadata', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.meta).to.include.all.keys(",
                  "    'total', 'page', 'limit', 'totalPages', 'hasNextPage', 'hasPreviousPage',",
                  "  );",
                  "});",
                  "",
                  "pm.test('honours the requested page size', () => pm.expect(body.meta.limit).to.eql(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "List films rejects an invalid sort field",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/films?sortBy=password",
              "host": ["{{baseUrl}}"],
              "path": ["films"],
              "query": [{ "key": "sortBy", "value": "password" }]
            },
            "description": "Sorting is an allow-list, not a passthrough to the column name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync from the Star Wars API (admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/films/sync",
              "host": ["{{baseUrl}}"],
              "path": ["films", "sync"]
            },
            "description": "Imports the upstream catalogue. Matches films by episode number, so sending it twice is safe — the second run reports everything as unchanged. Send it again right now and watch `created` drop to zero."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('reports what it did instead of an empty body', () => {",
                  "  pm.expect(body).to.include.all.keys('created', 'updated', 'unchanged', 'received', 'durationMs');",
                  "});",
                  "",
                  "pm.test('touched every film it received', () => {",
                  "  pm.expect(body.created + body.updated + body.unchanged).to.eql(body.received);",
                  "});",
                  "",
                  "pm.test('imported something', () => pm.expect(body.received).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync again changes nothing",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/films/sync",
              "host": ["{{baseUrl}}"],
              "path": ["films", "sync"]
            },
            "description": "The idempotency check: the same import, immediately after, must create and update nothing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('creates nothing the second time', () => pm.expect(body.created).to.eql(0));",
                  "pm.test('updates nothing the second time', () => pm.expect(body.updated).to.eql(0));",
                  "pm.test('reports every film as unchanged', () => pm.expect(body.unchanged).to.eql(body.received));"
                ]
              }
            }
          ]
        },
