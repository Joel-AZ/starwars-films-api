{
  "info": {
    "name": "Star Wars Films API",
    "description": "Film management API built with NestJS.\n\nEverything is pre-filled — open any request and press Send, in any order. When `accessToken` is empty a collection-level script logs in as the regular user first, and if that account does not exist yet it creates it through `POST /auth/register`, the same endpoint any client would use.\n\nThe administrator is the one account that cannot come from the API: registration hardcodes the USER role so nobody can self-promote. Run `pnpm db:seed` once to create it.\n\n| Role | Email | Password | Created by |\n| --- | --- | --- | --- |\n| ADMIN | admin@starwars.test | Password123! | `pnpm db:seed` |\n| USER | user@starwars.test | Password123! | the collection, via `/auth/register` |\n\nPoint `baseUrl` somewhere else and the whole collection follows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Makes every protected request runnable on its own: fetches the two",
          "// tokens the collection needs, and on a fresh database creates the",
          "// regular user first through the public registration endpoint. Each",
          "// half only fires when its token is missing — clear a token to force",
          "// it to run again.",
          "const baseUrl = pm.collectionVariables.get('baseUrl');",
          "const email = pm.collectionVariables.get('userEmail');",
          "const password = pm.collectionVariables.get('userPassword');",
          "const name = pm.collectionVariables.get('userName');",
          "",
          "const post = (path, body) => ({",
          "  url: `${baseUrl}${path}`,",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify(body) },",
          "});",
          "",
          "const store = (key) => (response) =>",
          "  pm.collectionVariables.set(key, response.json().accessToken);",
          "",
          "if (!pm.collectionVariables.get('accessToken')) {",
          "  pm.sendRequest(post('/auth/login', { email, password }), (loginError, loginResponse) => {",
          "    if (!loginError && loginResponse.code === 200) {",
          "      store('accessToken')(loginResponse);",
          "      return;",
          "    }",
          "",
          "    pm.sendRequest(",
          "      post('/auth/register', { email, name, password }),",
          "      (registerError, registerResponse) => {",
          "        if (registerError || registerResponse.code !== 201) {",
          "          console.warn('Could not obtain a user token. Is the API running on ' + baseUrl + '?');",
          "          return;",
          "        }",
          "",
          "        store('accessToken')(registerResponse);",
          "      },",
          "    );",
          "  });",
          "}",
          "",
          "// The administrator cannot be registered through the API, so this one",
          "// only ever logs in. If it fails, the seed has not been run.",
          "if (!pm.collectionVariables.get('adminToken')) {",
          "  const adminCredentials = {",
          "    email: pm.collectionVariables.get('adminEmail'),",
          "    password: pm.collectionVariables.get('adminPassword'),",
          "  };",
          "",
          "  pm.sendRequest(post('/auth/login', adminCredentials), (error, response) => {",
          "    if (error || response.code !== 200) {",
          "      console.warn('Could not obtain an admin token. Did you run `pnpm db:seed`?');",
          "      return;",
          "    }",
          "",
          "    store('adminToken')(response);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "user@starwars.test",
      "type": "string"
    },
    {
      "key": "userName",
      "value": "Luke Skywalker",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@starwars.test",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "newUserEmail",
      "value": "",
